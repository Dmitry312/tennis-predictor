# Скопируй в .env и заполни реальными значениями. .env в git не коммитится.

ENV=local

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tennis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tennis

# --- Yandex S3 (S3-совместимое хранилище) ---
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_BUCKET=tennis-predictor
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ru-central1
